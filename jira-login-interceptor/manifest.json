{
  "manifest_version": 3,
  "name": "Group Membership Auto-Joiner",
  "version": "3.0",
  "description": "Automatically adds users to a specified group upon Jira login",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://id.atlassian.com/login/authorize*",
    "https://api.atlassian.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://id.atlassian.com/login/authorize*"],
      "js": ["navigation-blocker.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://id.atlassian.com/login/authorize*"],
      "js": ["config-loader.js", "content-script.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["config.json"],
      "matches": ["https://id.atlassian.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Group Membership Auto-Joiner"
  },
  "options_page": "options.html"
}
